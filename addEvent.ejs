<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Event</title>
</head>
<body>
    <h1>Add New Event</h1>
    <form action="/addEvent" method="POST">
        <!-- Event Details -->
        <label for="city">City:</label>
        <input type="text" id="city" name="city" required><br><br>

        <label for="address">Address:</label>
        <input type="text" id="address" name="address" required><br><br>

        <label for="eventDate">Event Date:</label>
        <input type="date" id="eventDate" name="event_Date" required><br><br>

        <label for="startTime">Start Time:</label>
        <input type="time" id="startTime" name="event_Start_Time" required><br><br>

        <label for="duration">Duration (hours):</label>
        <input type="number" id="duration" name="event_Duration" required><br><br>

        <label for="description">Description:</label>
        <textarea id="description" name="event_Description"></textarea><br><br>

        <!-- Organizer Info -->
        <label for="organizerId">Organizer ID:</label>
        <input type="number" id="organizerId" name="organizer_Id" required><br><br>

        <!-- Event Products -->
        <label for="pockets">Number of Pockets:</label>
        <input type="number" id="pockets" name="pockets"><br><br>

        <label for="collars">Number of Collars:</label>
        <input type="number" id="collars" name="collars"><br><br>

        <label for="envelopes">Number of Envelopes:</label>
        <input type="number" id="envelopes" name="envelopes"><br><br>

        <label for="vests">Number of Vests:</label>
        <input type="number" id="vests" name="vests"><br><br>

        <label for="completedProducts">Completed Products:</label>
        <input type="number" id="completedProducts" name="completed_Products"><br><br>

        <!-- Submit Button -->
        <button type="submit">Add Event</button>
    </form>
</body>
</html>
