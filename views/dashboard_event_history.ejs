<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Event Dashboard</title>
    <!-- CSS FILES -->
    <link href="/css/bootstrap.min.css" rel="stylesheet">
    <link href="/css/templatemo-kind-heart-charity.css" rel="stylesheet">
</head>
<body id="section_1">
    <%- include('partials/adminHeader') %>
    <div class="container mt-5">
        <h1 class="text-center mb-4">Event History</h1>

        <!-- Table -->
        <div class="table-responsive">
            <table class="table table-bordered table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Event ID</th>
                        <th>City</th>
                        <th>Address</th>
                        <th>Date</th>
                        <th>Start Time</th>
                        <th>Event Duration</th>
                        <th>Description</th>
                        <th>Pockets</th>
                        <th>Collars</th>
                        <th>Envelopes</th>
                        <th>Vests</th>
                        <th>Completed Products</th>
                        <th>Organizer</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% events.forEach(event => { %>
                        <tr>
                            <td><%= event.event_ID %></td>
                            <td><%= event.city %></td>
                            <td><%= event.address %></td>
                            <td>
                                <% if (event.event_Date) { %>
                                    <%= new Date(event.event_Date).toISOString().split('T')[0] %>
                                <% } else { %>
                                    N/A
                                <% } %>
                            </td>
                            <td><%= event.event_Start_Time %></td>
                            <td><%= event.event_Duration %></td>
                            <td><%= event.event_Description %></td>
                            <td><%= event.pockets %></td>
                            <td><%= event.collars %></td>
                            <td><%= event.envelopes %></td>
                            <td><%= event.vests %></td>
                            <td><%= event.completed_Products %></td>
                            <td>
                                <% if (event.organizer_Email) { %>
                                    <%= event.organizer_Email %>
                                <% } else { %>
                                    <%= event.organizer_Id %>
                                <% } %>
                            </td>
                            <td>
                                <a href="/editEvent/<%= event.event_ID %>" class="btn btn-warning btn-sm">Edit</a>
                                <form action="/deleteEvent/<%= event.event_ID %>" method="POST" style="display: inline;" onsubmit="return confirmDelete();">
                                    <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                </form>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>

        <!-- Action Buttons -->
        <div class="d-flex justify-content-between mt-4">
            <a href="/addEvent" class="btn btn-success">Add Event</a>
            <a href="/adminDashboard" class="btn btn-secondary">Back to Admin Dashboard</a>
        </div>
    </div>

    <!-- Confirm Delete Script -->
    <script>
        function confirmDelete() {
            return confirm("Are you sure you want to delete this event?");
        }
    </script>
    <!-- JS FILES -->
    <script src="/js/bootstrap.min.js"></script>
    <script src="/js/jquery.min.js"></script>
    <script src="/js/custom.js"></script>
</body>
</html>
