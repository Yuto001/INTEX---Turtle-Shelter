<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Volunteer Dashboard</title>
    <style>
        table {
            width: 100%;
            border-collapse: collapse;
        }
        th, td {
            border: 1px solid #ddd;
            padding: 8px;
            text-align: left;
        }
        th {
            background-color: #f4f4f4;
        }
        tr:nth-child(even) {
            background-color: #f9f9f9;
        }
        tr:hover {
            background-color: #f1f1f1;
        }
        button {
            padding: 5px 10px;
            margin: 2px;
            background-color: #007bff;
            color: white;
            border: none;
            cursor: pointer;
            border-radius: 3px;
        }
        button.delete {
            background-color: #dc3545;
        }
        button:hover {
            opacity: 0.9;
        }
    </style>
</head>
<body id="section_1">

    <header class="site-header">
        <div class="container">
            <div class="row align-items-center">
     
            </div>
        </div>
    </header>

    <nav class="navbar navbar-expand-lg bg-light shadow-lg">
        <div class="container">
            <a class="navbar-brand" href="index.html">
                <img src="turtlelogo1.png" class="logo img-fluid" alt="Turtle Shelter">
                <span>
                    Turtle Shelter Project
                    <small>Admin Page</small>
                </span>
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/">Home</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/adminDashboard">Dashboard</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/events">Events List</a> <!--add new event.ejs file-->
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/dashboard_event_history">Manage Events</a> 
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/dashboard_organizers">Manage Organizers</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/dashboard_volunteers">Manage Volunteers</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/dashboard_requests">Manage Requests</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
<body>
    <h1>Volunteer Dashboard</h1>

    <table>
        <thead>
            <tr>
                <th>Volunteer ID</th>
                <th>First Name</th>
                <th>Last Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Hours Available</th>
                <th>Sewing Skill</th>
                <th>Resource</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            <% volunteers.forEach(volunteer => { %>
                <tr>
                    <td><%= volunteer.volunteer_ID %></td>
                    <td><%= volunteer.volunteer_Fname %></td>
                    <td><%= volunteer.volunteer_Lname %></td>
                    <td><%= volunteer.volunteer_Email %></td>
                    <td><%= volunteer.volunteer_Phone %></td>
                    <td><%= volunteer.hours_Available %></td>
                    <!-- Updated Sewing Skill column -->
                    <td>
                        <% if (volunteer.sewing_Skill === 1) { %>
                            Beginner
                        <% } else if (volunteer.sewing_Skill === 2) { %>
                            Intermediate
                        <% } else if (volunteer.sewing_Skill === 3) { %>
                            Advanced
                        <% } else { %>
                            N/A
                        <% } %>
                    </td>
                    <td><%= volunteer.type %></td>

                    <td>
                        <!-- View Button -->
                        <a href="/viewVolun/<%= volunteer.volunteer_Email %>">
                            <button>View</button>
                        </a>

                        <!-- Edit Button -->
                        <a href="/editVolun/<%= volunteer.volunteer_Email %>">
                            <button>Edit</button>
                        </a>

                        <!-- Delete Button -->
                        <form action="/deleteVolun/<%= volunteer.volunteer_Email %>" method="POST" style="display: inline;" onsubmit="return confirmDelete();">
                            <button type="submit" class="delete">Delete</button>
                        </form>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>

    <!-- Add Volunteer Button -->
    <a href="/addVolun" style="margin-top: 20px; display: inline-block;">
        <button>Add Volunteer</button>
    </a>

    <!-- Back to dashboard -->
    <a href="/adminDashboard" style="margin-top: 20px; display: inline-block;">
        <button>Back to Admin Dashboard</button>
    </a>

    <!-- Confirmation script for delete -->
    <script>
        function confirmDelete() {
            return confirm("Are you sure you want to delete this volunteer? This action cannot be undone.");
        }
    </script>
</body>
</html>
