<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Event - Turtle Shelter Project</title>
    <!-- CSS FILES -->
    <link href="/css/bootstrap.min.css" rel="stylesheet">
    <link href="/css/bootstrap-icons.css" rel="stylesheet">
    <link href="/css/templatemo-kind-heart-charity.css" rel="stylesheet">
</head>
<body>
    <!-- Header -->
    <header class="site-header">
        <div class="container">
            <div class="row align-items-center">
                <!-- Contact Info -->
                <div class="col-lg-6 col-12 d-flex flex-wrap">
                    <p class="d-flex me-4 mb-0">
                        <i class="bi-geo-alt me-2"></i> Utah
                    </p>
                    <p class="d-flex mb-0">
                        <i class="bi-envelope me-2"></i>
                        <a href="tel:8018723190">801-872-3190</a>
                    </p>
                </div>

                <!-- Social Icons -->
                <div class="col-lg-3 col-12 d-lg-flex justify-content-end">
                    <ul class="social-icon">
                        <li class="social-icon-item">
                            <a href="https://www.facebook.com/turtleshelterproject" class="social-icon-link bi-facebook" target="_blank"></a>
                        </li>
                        <li class="social-icon-item">
                            <a href="https://www.instagram.com/turtleshelterproject" class="social-icon-link bi-instagram" target="_blank"></a>
                        </li>
                        <li class="social-icon-item">
                            <a href="https://www.youtube.com/@turtleshelterproject7915" class="social-icon-link bi-youtube" target="_blank"></a>
                        </li>
                    </ul>
                </div>

                <!-- Login Button -->
                <div class="col-lg-3 col-12 text-end">
                    <a href="/login" class="logbtn"><span style="color: gray;">Employee Login</span></a>
                </div>
            </div>
        </div>
    </header>

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg bg-light shadow-lg">
        <div class="container">
            <a class="navbar-brand" href="/">
                <img src="turtlelogo1.png" class="logo img-fluid" alt="Turtle Shelter">
                <span>
                    Turtle Shelter Project
                    <small>Non-profit Organization</small>
                </span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link" href="/">Home</a></li>
                    <li class="nav-item"><a class="nav-link" href="#section_2">About</a></li>
                    <li class="nav-item"><a class="nav-link" href="#section_3">Causes</a></li>
                    <li class="nav-item"><a class="nav-link" href="#section_4">Volunteer</a></li>
                    <li class="nav-item"><a class="nav-link" href="/jensStory">Jen's Story</a></li>
                    <li class="nav-item ms-3"><a class="nav-link custom-btn btn" href="/donate">Donate</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main>
        <div class="container mt-5">
            <h1 class="text-center mb-4">Add New Event</h1>
            <form action="/addEvent" method="POST" class="needs-validation" novalidate>
                <div class="row">
                    <!-- City and Address -->
                    <div class="col-md-6 mb-3">
                        <label for="city" class="form-label">City:</label>
                        <input type="text" class="form-control" id="city" name="city" required>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="address" class="form-label">Address:</label>
                        <input type="text" class="form-control" id="address" name="address" required>
                    </div>
                </div>

                <div class="row">
                    <!-- Event Date and Start Time -->
                    <div class="col-md-6 mb-3">
                        <label for="eventDate" class="form-label">Event Date:</label>
                        <input type="date" class="form-control" id="eventDate" name="event_Date" required>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="startTime" class="form-label">Start Time:</label>
                        <input type="time" class="form-control" id="startTime" name="event_Start_Time" required>
                    </div>
                </div>

                <div class="row">
                    <!-- Duration and Organizer ID -->
                    <div class="col-md-6 mb-3">
                        <label for="duration" class="form-label">Duration (hours):</label>
                        <input type="number" class="form-control" id="duration" name="event_Duration" required>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="organizerId" class="form-label">Organizer ID:</label>
                        <input type="number" class="form-control" id="organizerId" name="organizer_Id" required>
                    </div>
                </div>

                <div class="mb-3">
                    <!-- Description -->
                    <label for="description" class="form-label">Description:</label>
                    <textarea class="form-control" id="description" name="event_Description" rows="4"></textarea>
                </div>

                <div class="row">
                    <!-- Product Inputs -->
                    <div class="col-md-4 mb-3">
                        <label for="pockets" class="form-label">Number of Pockets:</label>
                        <input type="number" class="form-control" id="pockets" name="pockets">
                    </div>
                    <div class="col-md-4 mb-3">
                        <label for="collars" class="form-label">Number of Collars:</label>
                        <input type="number" class="form-control" id="collars" name="collars">
                    </div>
                    <div class="col-md-4 mb-3">
                        <label for="envelopes" class="form-label">Number of Envelopes:</label>
                        <input type="number" class="form-control" id="envelopes" name="envelopes">
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="vests" class="form-label">Number of Vests:</label>
                        <input type="number" class="form-control" id="vests" name="vests">
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="completedProducts" class="form-label">Completed Products:</label>
                        <input type="number" class="form-control" id="completedProducts" name="completed_Products">
                    </div>
                </div>

                <!-- Submit Button -->
                <div class="text-center">
                    <button type="submit" class="btn btn-primary">Add Event</button>
                </div>
            </form>
        </div>
    </main>

    <!-- Footer -->
    <footer class="site-footer mt-5">
        <div class="container">
            <div class="row">
                <div class="col-lg-12 text-center">
                    <p>Copyright © 2036 Turtle Shelter Project. Design by TemplateMo</p>
                </div>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="/js/bootstrap.min.js"></script>
    <script src="/js/jquery.min.js"></script>
    <script src="/js/custom.js"></script>
</body>
</html>
