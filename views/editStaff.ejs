        </div>
    </nav>
<body>
    <h1>Edit Staff Member: <%= staff.username %></h1>
    
    <form action="/editStaff/<%= staff.username %>" method="POST">
        <label for="password">New Password:</label>
        <input type="password" id="password" name="password" required>
        
        <button type="submit">Update Password</button>
    </form>
    
    <br>
    <a href="/database_staff_accounts">Back to Staff Accounts</a>
