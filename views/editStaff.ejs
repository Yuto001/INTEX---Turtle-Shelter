<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Staff</title>
    <!-- CSS FILES -->
    <link href="/css/bootstrap.min.css" rel="stylesheet">
    <link href="/css/bootstrap-icons.css" rel="stylesheet">
    <link href="/css/templatemo-kind-heart-charity.css" rel="stylesheet">
    <style>
        .container {
            margin-top: 50px;
            max-width: 600px;
            background-color: #f9f9f9;
            padding: 30px;
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }
        h1 {
            text-align: center;
            margin-bottom: 30px;
            font-size: 2rem;
            color: #333;
        }
        label {
            font-weight: bold;
            margin-bottom: 5px;
            display: block;
        }
        .form-container input,
        .form-container .form-button {
            width: 100%;
            padding: 10px;
            margin-bottom: 20px;
            border: 1px solid #ddd;
            border-radius: 5px;
            box-sizing: border-box;
        }
        .form-container .form-button {
            background-color: #007bff !important;
            color: white !important;
            font-weight: bold;
            border: none !important;
            cursor: pointer !important;
            transition: background-color 0.3s ease !important;
            text-align: center;
        }
        .form-container .form-button:hover {
            background-color: #0056b3 !important;
        }
        .form-buttons {
            display: flex;
            justify-content: space-between;
            gap: 10px;
        }
        .form-container a {
            display: block;
            text-align: center;
            color: #007bff !important;
            margin-top: 20px;
            text-decoration: none;
        }
        .form-container a:hover {
            text-decoration: underline !important;
        }
    </style>
</head>
<body id="section_1">
    <%- include('partials/adminHeader') %>

    <div class="container form-container">
        <h1>Edit Staff Member: <%= staffMember.username %></h1>
        
        <form action="/editStaff/<%= staffMember.username %>" method="POST">
            <label for="username">Username:</label>
            <input 
                type="text" 
                id="username" 
                name="username" 
                value="<%= staffMember.username %>" 
                required>
            
            <label for="password">Password:</label>
            <input 
                type="text" 
                id="password" 
                name="password" 
                value="<%= staffMember.password %>" 
                required>
                
            <label for="email">Email:</label>
            <input 
                type="email" 
                id="email" 
                name="email" 
                value="<%= staffMember.email %>" 
                required>

            <div class="form-buttons">
                <button type="submit" class="form-button">Update Info</button>
                <button type="button" class="form-button" onclick="location.href='/deleteStaff/<%= staffMember.username %>'">Delete Staff</button>
            </div>
        </form>
        
        <a href="/dashboard_staff_login">Back to Staff Accounts</a>
    </div>
    <%- include('partials/adminFooter') %>
    <!-- JAVASCRIPT FILES -->
    <script src="/js/jquery.min.js"></script>
    <script src="/js/bootstrap.min.js"></script>
    <script src="/js/jquery.sticky.js"></script>
    <script src="/js/click-scroll.js"></script>
    <script src="/js/custom.js"></script>
</body>
</html>