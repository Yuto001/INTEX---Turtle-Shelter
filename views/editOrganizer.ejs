<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Organizer</title>
    <!-- CSS FILES -->
    <link href="/css/bootstrap.min.css" rel="stylesheet">
    <link href="/css/bootstrap-icons.css" rel="stylesheet">
    <link href="/css/templatemo-kind-heart-charity.css" rel="stylesheet">
    <style>
        .container {
            margin-top: 50px;
            max-width: 700px;
            background-color: #f9f9f9;
            padding: 30px;
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }
        h1 {
            text-align: center;
            margin-bottom: 30px;
            font-size: 2rem;
            color: #333;
        }
        label {
            font-weight: bold;
            margin-bottom: 5px;
        }
        input, .form-button {
            width: 100%;
            padding: 10px;
            margin-bottom: 20px;
            border: 1px solid #ddd;
            border-radius: 5px;
        }
        .form-button {
            background-color: #007bff;
            color: white;
            font-weight: bold;
            border: none;
            cursor: pointer;
            transition: background-color 0.3s ease;
        }
        .form-button:hover {
            background-color: #0056b3;
        }
        .form-buttons {
            display: flex;
            justify-content: space-between;
            gap: 10px;
        }
    </style>
</head>
<body id="section_1">
    <%- include('partials/adminHeader') %>

    <div class="container">
        <h1>Edit Organizer</h1>
        <form action="/editOrganizer" method="POST">
            <!-- Organizer ID (Hidden Field) -->
            <input type="hidden" name="organizer_ID" value="<%= organizer.organizer_ID %>">

            <div class="form-group">
                <label for="organizer_First">First Name:</label>
                <input type="text" id="organizer_First" name="organizer_First" value="<%= organizer.organizer_First %>" required>
            </div>

            <div class="form-group">
                <label for="organizer_Last">Last Name:</label>
                <input type="text" id="organizer_Last" name="organizer_Last" value="<%= organizer.organizer_Last %>" required>
            </div>

            <div class="form-group">
                <label for="organizer_Email">Email:</label>
                <input type="email" id="organizer_Email" name="organizer_Email" value="<%= organizer.organizer_Email %>" required>
            </div>

            <div class="form-group">
                <label for="organizer_Phone">Phone:</label>
                <input type="tel" id="organizer_Phone" name="organizer_Phone" value="<%= organizer.organizer_Phone %>" required>
            </div>

            <div class="form-buttons">
                <button type="submit" class="form-button">Update Organizer</button>
                <button type="button" class="form-button" onclick="location.href='/deleteOrganizer/<%= organizer.organizer_ID %>'">Delete Organizer</button>
            </div>
        </form>
    </div>
    <%- include('partials/adminFooter') %>
    <!-- JAVASCRIPT FILES -->
    <script src="/js/jquery.min.js"></script>
    <script src="/js/bootstrap.min.js"></script>
    <script src="/js/jquery.sticky.js"></script>
    <script src="/js/click-scroll.js"></script>
    <script src="/js/custom.js"></script>
</body>
</html>
