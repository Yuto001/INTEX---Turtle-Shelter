<body>
    <h1>Edit Organizer</h1>
    <form action="/editOrganizer" method="POST">
        <!-- Organizer ID (Hidden Field) -->
        <input type="hidden" name="organizer_ID" value="<%= organizer.organizer_ID %>">

        <label for="organizer_First">First Name:</label>
        <input type="text" id="organizer_First" name="organizer_First" value="<%= organizer.organizer_First %>" required>
        <br><br>

        <label for="organizer_Last">Last Name:</label>
        <input type="text" id="organizer_Last" name="organizer_Last" value="<%= organizer.organizer_Last %>" required>
        <br><br>

        <label for="organizer_Email">Email:</label>
        <input type="email" id="organizer_Email" name="organizer_Email" value="<%= organizer.organizer_Email %>" required>
        <br><br>

        <label for="organizer_Phone">Phone:</label>
        <input type="tel" id="organizer_Phone" name="organizer_Phone" value="<%= organizer.organizer_Phone %>" required>
        <br><br>

        <button type="submit">Update Organizer</button>
    </form>
</body>
</html>
