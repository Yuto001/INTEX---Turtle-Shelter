<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Turtle Shelter Project</title>
    <link rel="stylesheet" href="/public/style.css">
</head>
<body>
    <header>
        <div class="container">
            <div class="logo">
                <h1>Turtle Shelter Project</h1>
            </div>
            <nav>
                <ul>
                    <li><a href="#about">About</a></li>
                    <li><a href="#events">Events</a></li>
                    <li><a href="#volunteer">Volunteer</a></li>
                    <li><a href="#donate">Donate</a></li>
                </ul>
            </nav>
        </div>
    </header>

    <section id="hero">
        <div class="hero-container">
            <h1>Providing Warmth, Saving Lives</h1>
            <p>Empowering our community to make a difference through innovative solutions for homelessness.</p>
            <a href="#volunteer" class="cta-button">Join the Mission</a>
        </div>
    </section>    

    <section id="about">
        <div class="container">
            <h2>About Us</h2>
            <div class="about-content">
                <div class="about-text">
                    <p>We are dedicated to providing portable shelter solutions for individuals experiencing homelessness. Our Turtle Shelter vests are designed to keep users warm and dry, even in harsh conditions.</p>
                </div>
                <div class="about-image">
                    <div class="placeholder about-placeholder"></div>
                </div>
            </div>
        </div>
    </section>

    <section id="events">
        <div class="container">
            <h2>Upcoming Events</h2>
            <div class="events-grid">
                <div class="event">
                    <div class="event-image placeholder"></div>
                    <h3>Vest Sewing Workshop</h3>
                    <p>Date: December 15, 2024</p>
                    <p>Location: Salt Lake City Community Center</p>
                    <a href="#" class="cta-button">Sign Up</a>
                </div>
                <div class="event">
                    <div class="event-image placeholder"></div>
                    <h3>Holiday Donation Drive</h3>
                    <p>Date: December 20, 2024</p>
                    <p>Location: Downtown Plaza</p>
                    <a href="#" class="cta-button">Learn More</a>
                </div>
            </div>
        </div>
    </section>

    <section id="volunteer">
        <div class="container">
            <h2>Volunteer With Us</h2>
            <p>Become a part of the solution. Sign up to help make vests, organize events, or distribute Turtle Shelter vests to those in need.</p>
            <a href="#" class="cta-button">Volunteer Now</a>
        </div>
    </section>

    <footer>
        <div class="container">
            <div class="footer-content">
                <p>&copy; 2024 Turtle Shelter Project. All rights reserved.</p>
                <p>Contact: <a href="mailto:info@turtleshelterproject.org">info@turtleshelterproject.org</a></p>
            </div>
        </div>
    </footer>
</body>
</html>

