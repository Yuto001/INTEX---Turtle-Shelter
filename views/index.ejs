<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">

        <meta name="description" content="">
        <meta name="author" content="">

        <title>Turtle Shelter Project</title>

        <!-- CSS FILES -->        
        <link href="css/bootstrap.min.css" rel="stylesheet">
        <link href="css/bootstrap-icons.css" rel="stylesheet">
        <link href="css/templatemo-kind-heart-charity.css" rel="stylesheet">
        <link rel="stylesheet" href="css/login.css">

    </head>
    
    <!--this gets our header into the page-->
    <%- include('partials/header') %>

        <main>
            <!--carosel images section-->
            <section class="hero-section hero-section-full-height">
                <div class="container-fluid">
                    <div class="row">

                        <div class="col-lg-12 col-12 p-0">
                            <div id="hero-slide" class="carousel carousel-fade slide" data-bs-ride="carousel">
                                <div class="carousel-inner">
                                    <div class="carousel-item active">
                                        <img src="images/TurtleShelterProjectPhoto6.jpg" class="carousel-image img-fluid" alt="...">
                                        
                                        <div class="carousel-caption d-flex flex-column justify-content-end">
                                            <h2>A Shelter of Hope</h2>
                                            
                                            <p>Together, we can provide safety and dignity for those in need.</p>
                                        </div>
                                    </div>

                                    <div class="carousel-item">
                                        <img src="/TurtleImage.jpg" class="carousel-image img-fluid" alt="...">
                                        
                                        <div class="carousel-caption d-flex flex-column justify-content-end">
                                            <h2>Heat Saves Lives</h2>
                                            
                                            <p>Help us protect people from the dangers of cold weather.</p>
                                        </div>
                                    </div>

                                    <div class="carousel-item">
                                        <img src="images/TurtleShelterProjectPhoto2Croped.jpg" class="carousel-image img-fluid" alt="...">
                                        
                                        <div class="carousel-caption d-flex flex-column justify-content-end">
                                            <h2>Empathy in Action</h2>
                                            
                                            <p>Spread kindness. Support life-saving efforts.</p>
                                        </div>
                                    </div>
                                </div>

                                <button class="carousel-control-prev" type="button" data-bs-target="#hero-slide" data-bs-slide="prev">
                                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                    <span class="visually-hidden">Previous</span>
                                </button>

                                <button class="carousel-control-next" type="button" data-bs-target="#hero-slide" data-bs-slide="next">
                                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                    <span class="visually-hidden">Next</span>
                                </button>
                            </div>
                        </div>

                    </div>
                </div>
            </section>

            <!--Welcome to TSP Section-->
            <section class="section-padding">
                <div class="container">
                    <div class="row">

                        <div class="col-lg-10 col-12 text-center mx-auto">
                            <h2 class="mb-5">Welcome to Turtle Shelter Project</h2>
                        </div>

                        <div class="col-lg-3 col-md-6 col-12 mb-4 mb-lg-0">
                            <div class="featured-block d-flex justify-content-center align-items-center">
                                <a href="addVolun" class="d-block">
                                    <img src="images/icons/hands.png" class="featured-block-image img-fluid" alt="">

                                    <p class="featured-block-text">Become a <strong>volunteer</strong></p>
                                </a>
                            </div>
                        </div>

                        <div class="col-lg-3 col-md-6 col-12 mb-4 mb-lg-0 mb-md-4">
                            <div class="featured-block d-flex justify-content-center align-items-center">
                                <a href="techInfo" class="d-block">
                                    <img src="images/vest.png" class="featured-block-image img-fluid" alt="">

                                    <p class="featured-block-text">Our <strong>Tech</strong></p>
                                </a>
                            </div>
                        </div>

                        <div class="col-lg-3 col-md-6 col-12 mb-4 mb-lg-0 mb-md-4">
                            <div class="featured-block d-flex justify-content-center align-items-center">
                                <a href="donate" class="d-block">
                                    <img src="images/icons/receive.png" class="featured-block-image img-fluid" alt="">

                                    <p class="featured-block-text">Make a <strong>Donation</strong></p>
                                </a>
                            </div>
                        </div>

                        <div class="col-lg-3 col-md-6 col-12 mb-4 mb-lg-0">
                            <div class="featured-block d-flex justify-content-center align-items-center">
                                <a href="addEvent" class="d-block">
                                    <img src="images/icons/heart.png" class="featured-block-image img-fluid" alt="">

                                    <p class="featured-block-text"><strong>Schedule</strong> an Event</p>
                                </a>
                            </div>
                        </div>

                    </div>
                </div>
            </section>
            
            <!--TSP Information Section-->
            <section class="section-padding section-bg" id="section_2">
                <div class="container">
                    <div class="row">
                        <!-- Image Column -->
                        <div class="col-lg-6 col-12 mb-5 mb-lg-0">
                            <img src="images/TurtleShelterProjectPhoto1.jpg" class="custom-text-box-image img-fluid" style="max-width: 100%; height: auto;" alt="">
                        </div>
            
                        <!-- Content Column -->
                        <div class="col-lg-6 col-12">
                            <div class="custom-text-box">
                                <h2 class="mb-2">Our Story</h2>
                                <h5 class="mb-3">Turtle Shelter Project, Non-Profit Organization</h5>
                                <p class="mb-0">The Turtle Shelter Project helps people experiencing homelessness by providing insulated vests that double as portable shelters. Founded by Jen Spencer, who overcame homelessness herself, the project focuses on offering warmth, dignity, and hope. Volunteers and donations support their mission to make a positive impact in their community.</p>
                                <a href="/techInfo" class="custom-btn btn mt-4">Read About Our Vests</a>
                            </div>
            
                            <!-- Row for Mission and Counters -->
                            <div class="row mt-4">
                                <!-- Mission Section -->
                                <div class="col-lg-6 col-md-6 col-12">
                                    <div class="custom-text-box mb-lg-0">
                                        <h5 class="mb-3">Our Mission</h5>
                                        <p>Every Life has Value, Every Person can Serve.</p>
                                        <ul class="custom-list mt-2">
                                            <li class="custom-list-item d-flex">
                                                <i class="bi-check custom-text-box-icon me-2"></i> Design and Create Life-Saving Vests
                                            </li>
                                            <li class="custom-list-item d-flex">
                                                <i class="bi-check custom-text-box-icon me-2"></i> Deliver Warmth to Those in Need
                                            </li>
                                        </ul>
                                    </div>
                                </div>
            
                                <!-- Counter Section -->
                                <div class="col-lg-6 col-md-6 col-12">
                                    <div class="custom-text-box">
                                        <div class="counter-thumb">
                                            <div class="d-flex">
                                                <span class="counter-number" data-from="1" data-to="2017" data-speed="1000"></span>
                                                <span class="counter-number-text"></span>
                                            </div>
                                            <span class="counter-text">Incorporated</span>
                                        </div>
                                        <div class="counter-thumb mt-4">
                                            <div class="d-flex">
                                                <span class="counter-number" data-from="1" data-to="55" data-speed="1000"></span>
                                                <span class="counter-number-text">K</span>
                                            </div>
                                            <span class="counter-text">Vests Donated</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!-- End Row -->
                        </div>
                    </div>
                </div>
            </section>
            

            <!--Jens Story Section-->
            <section class="about-section section-padding">
                <div class="container">
                    <div class="row">

                        <div class="col-lg-6 col-md-5 col-12">
                            <img src="/images/Jen_Photo.png" class="about-image ms-lg-auto bg-light shadow-lg img-fluid" alt="">
                        </div>

                        <div class="col-lg-5 col-md-7 col-12">
                            <div class="custom-text-block">
                                <h2 class="mb-0">Jen Spencer</h2>

                                <p class="text-muted mb-lg-4 mb-md-4">Founding Partner, Turtle Shelter Project</p>

                                <p>Passionate advocate for those experiencing homelessness, leveraging personal experiences and recovery to create cost-effective life-saving Vests.</p>

                                <p>Dedicated to providing durable, cost-effective warmth solutions for those experiencing homelessness.</p>

                                <!-- Navigation Button -->
                                <a href="/jensStory" class="custom-btn btn mt-4">Read Jen's Full Story</a>
                            </div>
                        </div>

                    </div>
                </div>
            </section>

            <!--filler bar section Section-->
            <section class="cta-section section-padding section-bg">
                <div class="container">
                    <div class="row justify-content-center align-items-center">

                        <div class="col-lg-5 col-12 ms-auto">
                            <h2 class="mb-0">Make an impact. <br> Save lives.</h2>
                        </div>

                        <div class="col-lg-5 col-12">
                            <a href="donate" class="me-4">Make a donation</a>

                            <a href="addVolun" class="custom-btn btn smoothscroll">Become a volunteer</a>
                        </div>

                    </div>
                </div>
            </section>

            <!--footer partial-->
            <%- include('partials/footer') %>

        <!-- JAVASCRIPT FILES -->
        <script src="js/jquery.min.js"></script>
        <script src="js/bootstrap.min.js"></script>
        <script src="js/jquery.sticky.js"></script>
        <script src="js/counter.js"></script>
        <script src="js/custom.js"></script>

    </body>
</html>