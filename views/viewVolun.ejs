<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Volunteer Events</title>
    <!-- CSS FILES -->
    <link href="/css/bootstrap.min.css" rel="stylesheet">
    <link href="/css/bootstrap-icons.css" rel="stylesheet">
    <link href="/css/templatemo-kind-heart-charity.css" rel="stylesheet">
    <style>
        .container {
            margin-top: 50px;
        }
        h1 {
            text-align: center;
            margin-bottom: 20px;
            font-size: 2rem;
            color: #333;
        }
        .btn {
            margin: 10px 0;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            background-color: #fff;
            box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);
        }
        th, td {
            border: 1px solid #ddd;
            padding: 10px;
            text-align: left;
        }
        th {
            background-color: #f4f4f4;
            font-weight: bold;
        }
        tr:nth-child(even) {
            background-color: #f9f9f9;
        }
        tr:hover {
            background-color: #f1f1f1;
        }
        .no-events {
            text-align: center;
            font-size: 1.2rem;
            color: #666;
        }
    </style>
</head>
<body id="section_1">
    <%- include('partials/adminHeader') %>

    <div class="container">
        <h1>Volunteer Events for <%= volunteer.volunteer_Fname %> <%= volunteer.volunteer_Lname %></h1>

        <!-- Add Event Button -->
        <div class="text-center mb-4">
            <a href="/addVolunteerEvent/<%= volunteer.volunteer_Email %>" class="btn btn-primary">
                Add Event
            </a>
        </div>

        <!-- Events Table -->
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Event ID</th>
                    <th>City</th>
                    <th>Address</th>
                    <th>Date</th>
                    <th>Start Time</th>
                    <th>Description</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <% if (events.length > 0) { %>
                    <% events.forEach(event => { %>
                        <tr>
                            <td><%= event.event_ID %></td>
                            <td><%= event.city %></td>
                            <td><%= event.address %></td>
                            <td>
                                <% if (event.event_Date) { %>
                                    <%= new Date(event.event_Date).toISOString().split('T')[0] %>
                                <% } else { %>
                                    N/A
                                <% } %>
                            </td>
                            <td><%= event.event_Start_Time %></td>
                            <td><%= event.event_Description %></td>
                            <td>
                                <!-- Delete Button -->
                                <form
                                    action="/deleteVolunteerEvent/<%= volunteer.volunteer_Email %>/<%= event.event_ID %>"
                                    method="POST"
                                    style="display: inline;"
                                    onsubmit="return confirmDelete();"
                                >
                                    <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                </form>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="7" class="text-center no-events">No events found for this volunteer.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>

        <!-- Back to Volunteer Dashboard -->
        <div class="text-center mt-4">
            <a href="/dashboard_volunteers" class="btn btn-secondary">
                Back to Volunteer Dashboard
            </a>
        </div>
    </div>

    <!-- Confirmation Script -->
    <script>
        function confirmDelete() {
            return confirm("Are you sure you want to delete this event? This action cannot be undone.");
        }
    </script>

    <!-- JAVASCRIPT FILES -->
    <script src="/js/jquery.min.js"></script>
    <script src="/js/bootstrap.min.js"></script>
    <script src="/js/jquery.sticky.js"></script>
    <script src="/js/custom.js"></script>
</body>
</html>
