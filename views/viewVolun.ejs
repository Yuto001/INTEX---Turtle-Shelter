<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Volunteer Events</title>
    <style>
        table {
            width: 100%;
            border-collapse: collapse;
        }
        th, td {
            border: 1px solid #ddd;
            padding: 8px;
            text-align: left;
        }
        th {
            background-color: #f4f4f4;
        }
        tr:nth-child(even) {
            background-color: #f9f9f9;
        }
        tr:hover {
            background-color: #f1f1f1;
        }
        button {
            padding: 5px 10px;
            margin: 2px;
            background-color: #007bff;
            color: white;
            border: none;
            cursor: pointer;
            border-radius: 3px;
        }
        button:hover {
            opacity: 0.9;
        }
    </style>
</head>
<body>
    <h1>Volunteer Events for <%= volunteer.volunteer_Fname %> <%= volunteer.volunteer_Lname %></h1>

    <!-- Add Event Button -->
    <a href="/addVolunteerEvent/<%= volunteer.volunteer_Email %>" style="margin-bottom: 20px; display: inline-block;">
        <button>Add Event</button>
    </a>

    <!-- Events Table -->
    <table>
        <thead>
            <tr>
                <th>Event ID</th>
                <th>City</th>
                <th>Address</th>
                <th>Date</th>
                <th>Start Time</th>
                <th>Description</th>
            </tr>
        </thead>
        <tbody>
            <% if (events.length > 0) { %>
                <% events.forEach(event => { %>
                    <tr>
                        <td><%= event.event_ID %></td>
                        <td><%= event.city %></td>
                        <td><%= event.address %></td>
                        <td><%= event.event_Date.toISOString().split('T')[0] %></td>
                        <td><%= event.event_Start_Time %></td>
                        <td><%= event.event_Description %></td>
                    </tr>
                <% }) %>
            <% } else { %>
                <tr>
                    <td colspan="6">No events found for this volunteer.</td>
                </tr>
            <% } %>
        </tbody>
    </table>
</body>
</html>
