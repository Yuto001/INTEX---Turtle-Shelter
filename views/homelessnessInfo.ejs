    <link href="/css/templatemo-kind-heart-charity.css" rel="stylesheet">
    <link rel="stylesheet" href="css/login.css">
    <style>
        /* Styling for the Tableau embed */
        .tableau-card {
            max-width: 900px;
            margin: 0 auto;
            background-color: #f9f9f9;
            border: 1px solid #ddd;
            border-radius: 10px;
            box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1);
            overflow: hidden;
        }
        .tableau-card iframe {
            width: 100%;
            height: 700px; /* Fixed to ensure consistent display */
            border: none;
            border-radius: 8px;
        }
        /* Fact Sheet Styling */
        .fact-sheet-section {
            background-color: #f9f9f9;
            padding: 50px 20px;
        }
        .fact-card {
            background-color: #ffffff;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1);
            text-align: center;
        }
        .fact-card h3 {
            font-size: 2rem;
            color: #007bff;
            font-weight: bold;
        }
        .fact-card p {
            font-size: 1rem;
            color: #555;
        }
    </style>
</head>
