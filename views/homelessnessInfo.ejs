<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rate of Homelessness Map - Turtle Shelter Project</title>
    <!-- CSS FILES -->
    <link href="/css/bootstrap.min.css" rel="stylesheet">
    <link href="/css/bootstrap-icons.css" rel="stylesheet">
    <link href="/css/templatemo-kind-heart-charity.css" rel="stylesheet">
    <style>
        /* Styling for the Tableau embed */
        .tableau-card {
            max-width: 900px;
            margin: 0 auto;
            background-color: #f9f9f9;
            border: 1px solid #ddd;
            border-radius: 10px;
            box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1);
            overflow: hidden;
        }
        .tableau-card iframe {
            width: 100%;
            height: 700px; /* Fixed to ensure consistent display */
            border: none;
            border-radius: 8px;
        }
        /* Fact Sheet Styling */
        .fact-sheet-section {
            background-color: #f9f9f9;
            padding: 50px 20px;
        }
        .fact-card {
            background-color: #ffffff;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1);
            text-align: center;
        }
        .fact-card h3 {
            font-size: 2rem;
            color: #007bff;
            font-weight: bold;
        }
        .fact-card p {
            font-size: 1rem;
            color: #555;
        }
    </style>
</head>
<body>
    <!-- Header -->
    <header class="site-header">
        <div class="container">
            <div class="row align-items-center">
                <!-- Contact Info -->
                <div class="col-lg-6 col-12 d-flex flex-wrap">
                    <p class="d-flex me-4 mb-0"><i class="bi-geo-alt me-2"></i> Utah</p>
                    <p class="d-flex mb-0"><i class="bi-envelope me-2"></i><a href="tel:8018723190">801-872-3190</a></p>
                </div>
                <!-- Social Icons -->
                <div class="col-lg-3 col-12 d-lg-flex justify-content-end">
                    <ul class="social-icon">
                        <li class="social-icon-item"><a href="https://www.facebook.com/turtleshelterproject" class="social-icon-link bi-facebook" target="_blank"></a></li>
                        <li class="social-icon-item"><a href="https://www.instagram.com/turtleshelterproject" class="social-icon-link bi-instagram" target="_blank"></a></li>
                        <li class="social-icon-item"><a href="https://www.youtube.com/@turtleshelterproject7915" class="social-icon-link bi-youtube" target="_blank"></a></li>
                    </ul>
                </div>
                <!-- Login Button -->
                <div class="col-lg-3 col-12 text-end">
                    <a href="/login" class="logbtn"><span style="color: gray;">Employee Login</span></a>
                </div>
            </div>
        </div>
    </header>

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg bg-light shadow-lg">
        <div class="container">
            <a class="navbar-brand" href="/">
                <img src="turtlelogo1.png" class="logo img-fluid" alt="Turtle Shelter">
                <span>
                    Turtle Shelter Project
                    <small>Non-profit Organization</small>
                </span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link" href="/">Home</a></li>
                    <li class="nav-item"><a class="nav-link" href="#section_2">About</a></li>
                    <li class="nav-item"><a class="nav-link" href="#section_3">Causes</a></li>
                    <li class="nav-item"><a class="nav-link" href="#section_4">Volunteer</a></li>
                    <li class="nav-item"><a class="nav-link" href="/jensStory">Jen's Story</a></li>
                    <li class="nav-item ms-3"><a class="nav-link custom-btn btn" href="/donate">Donate</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main>
        <!-- Tableau Section -->
        <section class="hero-section">
            <div class="container text-center">
                <h1 class="mb-4" style="font-size: 2.5rem; font-weight: bold; color: #333;">Rate of Homelessness Map</h1>
                <p class="text-muted mb-5" style="font-size: 1.2rem;">Explore the data on homelessness rates across different regions through this interactive map.</p>
                
                <div class="tableau-card">
                    <iframe 
                        src="https://public.tableau.com/views/2024RateofHomelessnessMap/Map?:showVizHome=no&:embed=true&:toolbar=no" 
                        allowfullscreen>
                    </iframe>
                </div>
            </div>
        </section>

        <!-- Fact Sheet Section -->
        <section class="fact-sheet-section">
            <div class="container">
                <h2 class="text-center mb-5" style="font-size: 2rem; font-weight: bold; color: #333;">Homelessness Facts</h2>
                <div class="row">
                    <div class="col-lg-4 col-md-6 mb-4">
                        <div class="fact-card">
                            <h3>580,466</h3>
                            <p>People experienced homelessness on a single night in 2022 in the U.S.</p>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-6 mb-4">
                        <div class="fact-card">
                            <h3>30%</h3>
                            <p>Increase in unsheltered homelessness since 2015.</p>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-6 mb-4">
                        <div class="fact-card">
                            <h3>106,364</h3>
                            <p>Homeless children and unaccompanied youth in 2022.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <!-- Footer -->
    <footer class="site-footer mt-5">
        <div class="container">
            <div class="row">
                <div class="col-lg-12 text-center">
                    <p>Copyright © 2036 Turtle Shelter Project. Design by TemplateMo</p>
                </div>
            </div>
        </div>
    </footer>

    <!-- JAVASCRIPT FILES -->
    <script src="js/jquery.min.js"></script>
    <script src="js/bootstrap.min.js"></script>
    <script src="js/jquery.sticky.js"></script>
    <script src="js/click-scroll.js"></script>
    <script src="js/counter.js"></script>
    <script src="js/custom.js"></script>
</body>

</html>
