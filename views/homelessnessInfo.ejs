<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rate of Homelessness Map - Turtle Shelter Project</title>
    <!-- CSS FILES -->
    <link href="/css/bootstrap.min.css" rel="stylesheet">
    <link href="/css/bootstrap-icons.css" rel="stylesheet">
    <link href="/css/templatemo-kind-heart-charity.css" rel="stylesheet">
    <link rel="stylesheet" href="css/login.css">
    <style>
        /* Styling for the Tableau embed */
        .tableau-card {
            max-width: 900px;
            margin: 0 auto;
            background-color: #f9f9f9;
            border: 1px solid #ddd;
            border-radius: 10px;
            box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1);
            overflow: hidden;
        }
        .tableau-card iframe {
            width: 100%;
            height: 700px; /* Fixed to ensure consistent display */
            border: none;
            border-radius: 8px;
        }
        /* Fact Sheet Styling */
        .fact-sheet-section {
            background-color: #f9f9f9;
            padding: 50px 20px;
        }
        .fact-card {
            background-color: #ffffff;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1);
            text-align: center;
        }
        .fact-card h3 {
            font-size: 2rem;
            color: #007bff;
            font-weight: bold;
        }
        .fact-card p {
            font-size: 1rem;
            color: #555;
        }
    </style>
</head>
<%- include('partials/header') %>
    <!-- Main Content -->
    <main>
        <!-- Tableau Section -->
        <section class="hero-section">
            <div class="container text-center">
                <h1 class="mb-4" style="font-size: 2.5rem; font-weight: bold; color: #333;">Rate of Homelessness Map</h1>
                <p class="text-muted mb-5" style="font-size: 1.2rem;">Explore the data on homelessness rates across different regions through this interactive map.</p>
                
                <div class="tableau-card">
                    <iframe 
                        src="https://public.tableau.com/views/2024RateofHomelessnessMap/Map?:showVizHome=no&:embed=true&:toolbar=no" 
                        allowfullscreen>
                    </iframe>
                </div>
            </div>
        </section>

        <!-- Fact Sheet Section -->
        <section class="fact-sheet-section">
            <div class="container">
                <h2 class="text-center mb-5" style="font-size: 2rem; font-weight: bold; color: #333;">Homelessness Facts</h2>
                <div class="row">
                    <div class="col-lg-4 col-md-6 mb-4">
                        <div class="fact-card">
                            <h3>580,466</h3>
                            <p>People experienced homelessness on a single night in 2022 in the U.S.</p>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-6 mb-4">
                        <div class="fact-card">
                            <h3>30%</h3>
                            <p>Increase in unsheltered homelessness since 2015.</p>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-6 mb-4">
                        <div class="fact-card">
                            <h3>106,364</h3>
                            <p>Homeless children and unaccompanied youth in 2022.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <!-- Footer -->
    <%- include('partials/footer') %>

    <!-- JAVASCRIPT FILES -->
    <script src="js/jquery.min.js"></script>
    <script src="js/bootstrap.min.js"></script>
    <script src="js/jquery.sticky.js"></script>
    <script src="js/click-scroll.js"></script>
    <script src="js/counter.js"></script>
    <script src="js/custom.js"></script>
</body>

</html>
