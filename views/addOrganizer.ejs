<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Organizer</title>
</head>
<%- include('partials/header') %>
<body>
    <h1>Add Organizer</h1>
    <form action="/addOrganizer" method="POST">

        <label for="organizer_Email">Email:</label>
        <input type="email" id="organizer_Email" name="organizer_Email" required>
        <br><br>

        <label for="organizer_First">First Name:</label>
        <input type="text" id="organizer_First" name="organizer_First" required>
        <br><br>

        <label for="organizer_Last">Last Name:</label>
        <input type="text" id="organizer_Last" name="organizer_Last" required>
        <br><br>

        <label for="organizer_Phone">Phone:</label>
        <input type="tel" id="organizer_Phone" name="organizer_Phone" required>
        <br><br>

        <button type="submit">Add Organizer</button>
    </form>
</body>
</html>