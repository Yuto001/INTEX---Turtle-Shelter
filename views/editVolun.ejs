<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Volunteer</title>
    <!-- CSS FILES -->
    <link href="/css/bootstrap.min.css" rel="stylesheet">
    <link href="/css/bootstrap-icons.css" rel="stylesheet">
    <link href="/css/templatemo-kind-heart-charity.css" rel="stylesheet">
    <style>
        .container {
            margin-top: 50px;
            max-width: 600px;
            background-color: #f9f9f9;
            padding: 30px;
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }
        h1 {
            text-align: center;
            margin-bottom: 30px;
            font-size: 2rem;
            color: #333;
        }
        label {
            font-weight: bold;
            margin-bottom: 5px;
            display: block;
        }
        input, select, .form-button {
            width: 100%;
            padding: 10px;
            margin-bottom: 20px;
            border: 1px solid #ddd;
            border-radius: 5px;
        }
        .form-button {
            background-color: #007bff;
            color: white;
            font-weight: bold;
            border: none;
            cursor: pointer;
            transition: background-color 0.3s ease;
        }
        .form-button:hover {
            background-color: #0056b3;
        }
        .form-buttons {
            display: flex;
            justify-content: space-between;
            gap: 10px;
        }
        a {
            display: block;
            text-align: center;
            color: #007bff;
            margin-top: 20px;
            text-decoration: none;
        }
        a:hover {
            text-decoration: underline;
        }
    </style>
</head>
<body id="section_1">
    <%- include('partials/adminHeader') %>

    <div class="container">
        <h1>Edit Volunteer</h1>

        <form action="/editVolun" method="POST">
            <!-- Volunteer ID (Hidden Field) -->
            <input type="hidden" name="volunteer_ID" value="<%= volunteer.volunteer_ID %>">

            <label for="volunteer_Email">Email:</label>
            <input type="email" id="volunteer_Email" name="volunteer_Email" value="<%= volunteer.volunteer_Email %>" required>

            <label for="volunteer_Fname">First Name:</label>
            <input type="text" id="volunteer_Fname" name="volunteer_Fname" value="<%= volunteer.volunteer_Fname %>" required>

            <label for="volunteer_Lname">Last Name:</label>
            <input type="text" id="volunteer_Lname" name="volunteer_Lname" value="<%= volunteer.volunteer_Lname %>" required>

            <label for="volunteer_Phone">Phone:</label>
            <input type="tel" id="volunteer_Phone" name="volunteer_Phone" value="<%= volunteer.volunteer_Phone %>" required>

            <label for="hours_Available">Hours Available:</label>
            <input type="number" id="hours_Available" name="hours_Available" value="<%= volunteer.hours_Available %>" required>

            <label for="sewing_Skill">Sewing Skill:</label>
            <select id="sewing_Skill" name="sewing_Skill" required>
                <option value="1" <%= volunteer.sewing_Skill === '1' ? 'selected' : '' %>>Beginner</option>
                <option value="2" <%= volunteer.sewing_Skill === '2' ? 'selected' : '' %>>Intermediate</option>
                <option value="3" <%= volunteer.sewing_Skill === '3' ? 'selected' : '' %>>Advanced</option>
            </select>

            <label for="vir_Id">Info Resource:</label>
            <select id="vir_Id" name="vir_Id" required>
                <% volunteer_info_resource.forEach(resource => { %>
                    <option value="<%= resource.vir_Id %>" <%= volunteer.vir_Id === resource.vir_Id ? 'selected' : '' %>>
                        <%= resource.type %>
                    </option>
                <% }) %>
            </select>            

            <div class="form-buttons">
                <button type="submit" class="form-button">Update Volunteer</button>
                <button type="button" class="form-button" onclick="location.href='/deleteVolunteer/<%= volunteer.volunteer_ID %>'">Delete Volunteer</button>
            </div>
        </form>

        <a href="/adminDashboard">Back to Admin Dashboard</a>
    </div>

    <%- include('partials/adminFooter') %>
    <!-- JAVASCRIPT FILES -->
    <script src="/js/jquery.min.js"></script>
    <script src="/js/bootstrap.min.js"></script>
    <script src="/js/jquery.sticky.js"></script>
    <script src="/js/click-scroll.js"></script>
    <script src="/js/custom.js"></script>
</body>
</html>
