<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Volunteer</title>
</head>
<body>
    <h1>Add Volunteer</h1>
    <form action="/addVolun" method="POST">

        <label for="volunteer_Email">Email:</label>
        <input type="email" id="volunteer_Email" name="volunteer_Email" required>
        <br><br>

        <label for="volunteer_Fname">First Name:</label>
        <input type="text" id="volunteer_Fname" name="volunteer_Fname" required>
        <br><br>

        <label for="volunteer_Lname">Last Name:</label>
        <input type="text" id="volunteer_Lname" name="volunteer_Lname" required>
        <br><br>

        <label for="volunteer_Phone">Phone:</label>
        <input type="tel" id="volunteer_Phone" name="volunteer_Phone" required>
        <br><br>

        <label for="hours_Available">Hours Available:</label>
        <input type="number" id="hours_Available" name="hours_Available" required>
        <br><br>

        <label for="sewing_Skill">Sewing Skill Level:</label>
        <select id="sewing_Skill" name="sewing_Skill" required>
            <option value="1">Beginner</option>
            <option value="2">Intermediate</option>
            <option value="3">Advanced</option>
        </select>
        <br><br>

        <label for="vir_Id">Info Resource:</label>
        <input type="number" id="vir_Id" name="vir_Id" required>
        <br><br>

        <button type="submit">Add Volunteer</button>
    </form>
</body>
</html>
