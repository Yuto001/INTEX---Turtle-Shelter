    <body id="section_1">

        <header class="site-header">
            <div class="container">
                <div class="row align-items-center">
                    <!-- Contact Info -->
                    <div class="col-lg-6 col-12 d-flex flex-wrap">
                        <p class="d-flex me-4 mb-0">
                            <i class="bi-geo-alt me-2"></i>
                            Northern Utah
                        </p>
        
                        <p class="d-flex mb-0">
                            <i class="bi-envelope me-2"></i>
                            <a href="mailto:TurtleShelterProject@gmail.com">TurtleShelterProject@gmail.com</a>
                        </p>
                    </div>
        
                    <!-- SNS Icons -->
                    <div class="col-lg-3 col-12 d-lg-flex justify-content-end">
                        <ul class="social-icon">
                            <li class="social-icon-item">
                                <a href="https://www.facebook.com/turtleshelterproject" class="social-icon-link bi-facebook" target="_blank"></a>
                            </li>
                            <li class="social-icon-item">
                                <a href="https://www.instagram.com/turtleshelterproject" class="social-icon-link bi-instagram" target="_blank"></a>
                            </li>
                            <li class="social-icon-item">
                                <a href="https://www.youtube.com/@turtleshelterproject7915" class="social-icon-link bi-youtube" target="_blank"></a>
                            </li>
                        </ul>
                    </div>
        
                    <!-- Login Button -->
                    <div class="col-lg-3 col-12 text-end">
                        <a href="/login" class="logbtn"><span style="color: gray;">Employee Login</span></a>
                    </div>
                </div>
            </div>
        </header>

        <nav class="navbar navbar-expand-lg bg-light shadow-lg">
            <div class="container">
                <a class="navbar-brand" href="index.html">
                    <img src="turtlelogo1.png" class="logo img-fluid" alt="Turtle Shelter">
                    <span>
                        Turtle Shelter Project
                        <small>Non-profit Organization</small>
                    </span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link click-scroll" href="/">Home</a>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link click-scroll dropdown-toggle" href="/#section_5" id="navbarLightDropdownMenuLink" role="button" data-bs-toggle="dropdown" aria-expanded="false">About</a>

                            <ul class="dropdown-menu dropdown-menu-light" aria-labelledby="navbarLightDropdownMenuLink">

                                <li><a class="dropdown-item" href="homelessnessInfo">Homelessness</a></li>

                                <li><a class="dropdown-item" href="jensStory">Jens Story</a></li>

                                <li><a class="dropdown-item" href="techInfo">Vest Technology</a></li>

                                <li><a class="dropdown-item" href="">Board of Directors</a></li>
                            </ul>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link click-scroll" href="">Events</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link click-scroll" href="addVolun">Volunteer</a>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link click-scroll dropdown-toggle" href="/#section_5" id="navbarLightDropdownMenuLink" role="button" data-bs-toggle="dropdown" aria-expanded="false">News</a>

                            <ul class="dropdown-menu dropdown-menu-light" aria-labelledby="navbarLightDropdownMenuLink">
                                <li><a class="dropdown-item" href="news">News Listing</a></li>

                                <li><a class="dropdown-item" href="news-detail">News Detail</a></li>
                            </ul>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link click-scroll" href="#section_6">Contact</a>
                        </li>

                        <li class="nav-item ms-3">
                            <a class="nav-link custom-btn custom-border-btn btn" href="/donate">Donate</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>

        <!-- Main Content -->
        <main>
            <div class="container mt-5">
                <h1 class="text-center mb-4">Add Volunteer</h1>
                <form action="/addVolun" method="POST" class="needs-validation" novalidate>
                    <div class="row">
                        <!-- Email -->
                        <div class="col-md-6 mb-3">
                            <label for="volunteer_Email" class="form-label">Email:</label>
                            <input type="email" class="form-control" id="volunteer_Email" name="volunteer_Email" required>
                        </div>
                        <!-- Phone -->
                        <div class="col-md-6 mb-3">
                            <label for="volunteer_Phone" class="form-label">Phone:</label>
                            <input type="tel" class="form-control" id="volunteer_Phone" name="volunteer_Phone" required>
                        </div>
                    </div>

                    <div class="row">
                        <!-- First Name -->
                        <div class="col-md-6 mb-3">
                            <label for="volunteer_Fname" class="form-label">First Name:</label>
                            <input type="text" class="form-control" id="volunteer_Fname" name="volunteer_Fname" required>
                        </div>
                        <!-- Last Name -->
                        <div class="col-md-6 mb-3">
                            <label for="volunteer_Lname" class="form-label">Last Name:</label>
                            <input type="text" class="form-control" id="volunteer_Lname" name="volunteer_Lname" required>
                        </div>
                    </div>

                    <div class="row">
                        <!-- Hours Available -->
                        <div class="col-md-6 mb-3">
                            <label for="hours_Available" class="form-label">Hours Available:</label>
                            <input type="number" class="form-control" id="hours_Available" name="hours_Available" required>
                        </div>
                        <!-- Sewing Skill -->
                        <div class="col-md-6 mb-3">
                            <label for="sewing_Skill" class="form-label">Sewing Skill Level:</label>
                            <select class="form-select" id="sewing_Skill" name="sewing_Skill" required>
                                <option value="1">Beginner</option>
                                <option value="2">Intermediate</option>
                                <option value="3">Advanced</option>
                            </select>
                        </div>
                    </div>

                    <div class="row">
                        <!-- Info Resource -->
                        <div class="col-md-6 mb-3">
                            <label for="vir_Id" class="form-label">Info Resource:</label>
                            <input type="number" class="form-control" id="vir_Id" name="vir_Id" required>
                        </div>
                    </div>

                    <!-- Submit Button -->
                    <div class="text-center">
                        <button type="submit" class="btn btn-primary">Add Volunteer</button>
                    </div>
                </form>
            </div>
        </main>

        <!-- Footer -->
        <footer class="site-footer mt-5">
            <div class="container">
                <div class="row">
                    <div class="col-lg-12 text-center">
                        <p>Copyright © 2036 Turtle Shelter Project. Design by TemplateMo</p>
                    </div>
                </div>
            </div>
        </footer>

        <!-- Scripts -->
        <script src="/js/bootstrap.min.js"></script>
        <script src="/js/jquery.min.js"></script>
        <script src="/js/custom.js"></script>
    </body>
</html>