<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Organizer Dashboard</title>
    <!-- CSS FILES -->
    <link href="/css/bootstrap.min.css" rel="stylesheet">
    <link href="/css/templatemo-kind-heart-charity.css" rel="stylesheet">
</head>
<body id="section_1">
    <%- include('partials/adminHeader') %>
    <div class="container mt-5">
        <h1 class="text-center mb-4">Organizer Dashboard</h1>

        <!-- Table -->
        <div class="table-responsive">
            <table class="table table-bordered table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Organizer ID</th>
                        <th>First Name</th>
                        <th>Last Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% organizers.forEach(organizer => { %>
                        <tr>
                            <td><%= organizer.organizer_ID %></td>
                            <td><%= organizer.organizer_First %></td>
                            <td><%= organizer.organizer_Last %></td>
                            <td><%= organizer.organizer_Email %></td>
                            <td><%= organizer.organizer_Phone %></td>
                            <td>
                                <!-- Edit button -->
                                <a href="/editOrganizer/<%= organizer.organizer_ID %>" class="btn btn-sm btn-primary mb-1">Edit</a>
                                <!-- Delete button -->
                                <form action="/deleteOrganizer/<%= organizer.organizer_ID %>" method="POST" style="display: inline;" onsubmit="return confirmDelete();">
                                    <button type="submit" class="btn btn-sm btn-danger mb-1">Delete</button>
                                </form>
                                <!-- View button -->    
                                <a href="/viewOrganizer/<%= organizer.organizer_Email %>" class="btn btn-sm btn-info">View</a>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>

        <!-- Action Buttons -->
        <div class="d-flex justify-content-between mt-4">
            <a href="/addOrganizer" class="btn btn-success">Add Organizer</a>
            <a href="/adminDashboard" class="btn btn-secondary">Back to Admin Dashboard</a>
        </div>
    </div>

    <!-- Confirmation script for delete -->
    <script>
        function confirmDelete() {
            return confirm("Are you sure you want to delete this organizer? This action cannot be undone.");
        }
    </script>
    <!-- JS FILES -->
    <script src="/js/bootstrap.min.js"></script>
    <script src="/js/jquery.min.js"></script>
    <script src="/js/custom.js"></script>
</body>
</html>
