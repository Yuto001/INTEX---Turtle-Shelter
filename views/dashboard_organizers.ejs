<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Organizer Dashboard</title>
    <style>
        table {
            width: 100%;
            border-collapse: collapse;
        }
        th, td {
            border: 1px solid #ddd;
            padding: 8px;
            text-align: left;
        }
        th {
            background-color: #f4f4f4;
        }
        tr:nth-child(even) {
            background-color: #f9f9f9;
        }
        tr:hover {
            background-color: #f1f1f1;
        }
        button {
            padding: 5px 10px;
            margin: 2px;
            background-color: #007bff;
            color: white;
            border: none;
            cursor: pointer;
            border-radius: 3px;
        }
        button.delete {
            background-color: #dc3545;
        }
        button:hover {
            opacity: 0.9;
        }
    </style>
</head>
<body id="section_1">

    <header class="site-header">
        <div class="container">
            <div class="row align-items-center">
     
            </div>
        </div>
    </header>

    <nav class="navbar navbar-expand-lg bg-light shadow-lg">
        <div class="container">
            <a class="navbar-brand" href="index.html">
                <img src="turtlelogo1.png" class="logo img-fluid" alt="Turtle Shelter">
                <span>
                    Turtle Shelter Project
                    <small>Admin Page</small>
                </span>
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/">Home</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/adminDashboard">Dashboard</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/events">Events List</a> <!--add new event.ejs file-->
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/dashboard_event_history">Manage Events</a> 
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/dashboard_organizers">Manage Organizers</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/dashboard_volunteers">Manage Volunteers</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/dashboard_requests">Manage Requests</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
<body>
    <h1>Organizer Dashboard</h1>

    <table>
        <thead>
            <tr>
                <th>Organizer ID</th>
                <th>First Name</th>
                <th>Last Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            <% organizers.forEach(organizer => { %>
                <tr>
                    <td><%= organizer.organizer_ID %></td>
                    <td><%= organizer.organizer_First %></td>
                    <td><%= organizer.organizer_Last %></td>
                    <td><%= organizer.organizer_Email %></td>
                    <td><%= organizer.organizer_Phone %></td>
                    <td>
                        <!-- Edit button -->
                        <a href="/editOrganizer/<%= organizer.organizer_ID %>">
                            <button>Edit</button>
                        </a>
                        <!-- Delete button -->
                        <form action="/deleteOrganizer/<%= organizer.organizer_ID %>" method="POST" style="display: inline;" onsubmit="return confirmDelete();">
                            <button type="submit" class="delete">Delete</button>
                        </form>
                        <!-- View button -->    
                        <a href="/viewOrganizer/<%= organizer.organizer_Email %>">
                            <button>View</button>
                        </a>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>

    <!-- Add Organizer Button -->
    <a href="/addOrganizer" style="margin-top: 20px; display: inline-block;">
        <button>Add Organizer</button>
    </a>
    <!-- Back to dashboard -->
    <a href="/adminDashboard" style="margin-top: 20px; display: inline-block;">
            <button>Back to Admin Dashboard</button>
    </a>

    <!-- Confirmation script for delete -->
    <script>
        function confirmDelete() {
            return confirm("Are you sure you want to delete this organizer? This action cannot be undone.");
        }
    </script>
</body>
</html>
