<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Events Page</title>

    <!-- CSS FILES -->
    <link href="css/bootstrap.min.css" rel="stylesheet">
    <link href="css/bootstrap-icons.css" rel="stylesheet">
    <link href="css/templatemo-kind-heart-charity.css" rel="stylesheet">
    <style>
        .container {
            margin-top: 50px;
        }
        h1 {
            text-align: center;
            margin-bottom: 20px;
            font-size: 2.5rem;
            color: #333;
        }
        iframe {
            display: block;
            margin: 20px auto;
            border-radius: 10px;
            width: 100%;
            max-width: 800px;
            height: 450px;
            border: 0;
        }
        table {
            width: 100%;
            margin-top: 30px;
            border-collapse: collapse;
            box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);
        }
        th, td {
            border: 1px solid #ddd;
            padding: 10px;
            text-align: left;
        }
        th {
            background-color: #f4f4f4;
            font-weight: bold;
        }
        tr:nth-child(even) {
            background-color: #f9f9f9;
        }
        tr:hover {
            background-color: #f1f1f1;
        }
        .btn-return {
            display: block;
            margin: 20px auto;
            padding: 10px 20px;
            background-color: #007bff;
            color: white;
            border: none;
            border-radius: 5px;
            font-size: 1rem;
        }
        .btn-return:hover {
            background-color: #0056b3;
        }
    </style>
</head>
<body id="section_1">

<%- include('partials/header') %>

<div class="container">
    <h1>Events List</h1>
    
    <!-- Google Maps Embed -->
    <iframe 
        src="https://www.google.com/maps/embed?pb=!1m14!1m12!1m3!1d24362.83408083363!2d-111.65696!3d40.24565760000001!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!5e0!3m2!1sja!2sus!4v1733251665265!5m2!1sja!2sus" 
        allowfullscreen="" 
        loading="lazy" 
        referrerpolicy="no-referrer-when-downgrade">
    </iframe>

    <!-- Events Table -->
    <table class="table table-striped">
        <thead>
            <tr>
                <th>City</th>
                <th>Address</th>
                <th>Event Start Time</th>
                <th>Event Date</th>
                <th>Event Duration</th>
                <th>Description</th>
                <th>Pockets Score</th>
                <th>Collars</th>
                <th>Envelopes</th>
                <th>Vests</th>
                <th>Completed Products</th>
            </tr>
        </thead>
        <tbody>
            <% eventInfo.forEach(event => { %>
                <tr>
                    <td><%= event.city %></td>
                    <td><%= event.address %></td>
                    <td><%= event.event_Start_Time %></td>
                    <td>
                        <% if (event.event_Date) { %>
                            <%= new Date(event.event_Date).toISOString().split('T')[0] %>
                        <% } else { %>
                            N/A
                        <% } %>
                    </td>
                    <td><%= event.event_Duration %> hours</td>
                    <td><%= event.event_Description %></td>
                    <td><%= event.pockets %></td>
                    <td><%= event.collars %></td>
                    <td><%= event.envelopes %></td>
                    <td><%= event.vests %></td>
                    <td><%= event.completed_Products %></td>
                </tr>
            <% }) %>
        </tbody>
    </table>

    <!-- Return Button -->
    <form action="/" method="GET">
        <button type="submit" class="btn-return">Return</button>
    </form>
</div>

<%- include('partials/footer') %>

<!-- JAVASCRIPT FILES -->
<script src="js/jquery.min.js"></script>
<script src="js/bootstrap.min.js"></script>
<script src="js/jquery.sticky.js"></script>
<script src="js/custom.js"></script>

</body>
</html>
