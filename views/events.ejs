<!DOCTYPE html>
<html lang="en">

<!--maybe adding the list of events with address, then admin can look for the specific place on the map-->

    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">

        <meta name="description" content="">
        <meta name="author" content="">

        <title>events Page</title>

        <!-- CSS FILES -->        
        <link href="css/bootstrap.min.css" rel="stylesheet">

        <link href="css/bootstrap-icons.css" rel="stylesheet">

        <link href="css/templatemo-kind-heart-charity.css" rel="stylesheet">
        <link rel="stylesheet" href="css/login.css">
    </head>
    <%- include('partials/header') %>
            <body>
                <iframe src="https://www.google.com/maps/embed?pb=!1m14!1m12!1m3!1d24362.83408083363!2d-111.65696!3d40.24565760000001!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!5e0!3m2!1sja!2sus!4v1733251665265!5m2!1sja!2sus" 
                width="600" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
            </body>
            <h1>Events List</h1>
    <table border="1">
        <thead>
            <tr>
                <th>City</th>
                <th>Address</th>
                <th>Event Start Time</th>
                <th>Event Date</th>
                <th>Event Duration</th>
                <th>Description</th>
                <th>Pockets Score</th>
                <th>Collars</th>
                <th>Envelopes</th>
                <th>Vests</th>
                <th>Completed Products</th>
            </tr>
        </thead>
        <tbody>
            <% eventInfo.forEach(event => { %>
                <tr>
                    <td><%= event.city %></td>
                    <td><%= event.address %></td>
                    <td><%= event.event_Start_Time %></td>
                    <td><%= event.event_Date %></td>
                    <td><%= event.event_Duration %></td>
                    <td><%= event.event_Description %></td>
                    <td><%= event.pockets %></td>
                    <td><%= event.collars %></td>
                    <td><%= event.envelopes %></td>
                    <td><%= event.vests %></td>
                    <td><%= event.completed_Products %></td>
                </tr>
            <% }); %>
        </tbody>
    </table>
    <form action="/" method="GET">
        <button type="submit">Return</button>
    </form>

            <div class="site-footer-bottom">
                <div class="container">
                    <div class="row">

