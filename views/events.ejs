            <h1>Events List</h1>
    <table border="1">
        <thead>
            <tr>
                <th>City</th>
                <th>Address</th>
                <th>Event Start Time</th>
                <th>Event Date</th>
                <th>Event Duration</th>
                <th>Description</th>
                <th>Pockets Score</th>
                <th>Collars</th>
                <th>Envelopes</th>
                <th>Vests</th>
                <th>Completed Products</th>
            </tr>
        </thead>
        <tbody>
            <% eventInfo.forEach(event => { %>
                <tr>
                    <td><%= event.city %></td>
                    <td><%= event.address %></td>
                    <td><%= event.event_Start_Time %></td>
                    <td><%= event.event_Date %></td>
                    <td><%= event.event_Duration %></td>
                    <td><%= event.event_Description %></td>
                    <td><%= event.pockets %></td>
                    <td><%= event.collars %></td>
                    <td><%= event.envelopes %></td>
                    <td><%= event.vests %></td>
                    <td><%= event.completed_Products %></td>
                </tr>
            <% }); %>
        </tbody>
    </table>
    <form action="/" method="GET">
        <button type="submit">Return</button>
    </form>

