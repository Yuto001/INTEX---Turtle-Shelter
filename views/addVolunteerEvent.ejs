<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Event for Volunteer</title>
    <!-- CSS FILES -->
    <link href="/css/bootstrap.min.css" rel="stylesheet">
    <link href="/css/templatemo-kind-heart-charity.css" rel="stylesheet">
</head>
<%- include('partials/adminHeader') %>
<body>
    <div class="container mt-5">
        <h1 class="text-center mb-4">Add Event for Volunteer: <%= volunteerEmail %></h1>
        <div class="card shadow-lg p-4">
            <!-- Form to Add Event -->
            <form action="/addVolunteerEvent/<%= volunteerEmail %>" method="POST">
                <div class="mb-3">
                    <label for="event_ID" class="form-label">Select Event:</label>
                    <select name="event_ID" id="event_ID" class="form-select" required>
                        <% events.forEach(event => { %>
                            <option value="<%= event.event_ID %>">
                                <%= event.event_ID %> - <%= event.event_Date %> - <%= event.event_Description %>
                            </option>
                        <% }) %>
                    </select>
                </div>

                <div class="text-center">
                    <button type="submit" class="btn btn-primary">Add Event</button>
                </div>
            </form>
        </div>
    </div>
    <%- include('partials/adminFooter') %>
    <!-- JAVASCRIPT FILES -->
    <script src="/js/bootstrap.min.js"></script>
    <script src="/js/jquery.min.js"></script>
    <script src="/js/custom.js"></script>
</body>
</html>

