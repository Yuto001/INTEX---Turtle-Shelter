<!DOCTYPE html>
<html lang="en">
<head>
    <!--log in page-->
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- CSS FILES -->        
    <link href="css/bootstrap.min.css" rel="stylesheet">
    <link href="css/bootstrap-icons.css" rel="stylesheet">
    <link href="css/templatemo-kind-heart-charity.css" rel="stylesheet">
    <link rel="stylesheet" href="css/login.css">
    <title>Log In Page</title>
    <style>
        
       body {
    margin: 0;
    display: flex;
    flex-direction: column;
    min-height: 100vh; /* Ensures full height */
    font-family: 'Arial', sans-serif; /* Clean font */
}

.error-box {
    background-color: #f8d7da; /* Light red background */
    color: #721c24;          /* Dark red text */
    padding: 10px;
    border: 1px solid #f5c6cb; /* Red border */
    border-radius: 5px;
    margin-bottom: 15px;      /* Space below the box */
    font-size: 14px;
    text-align: center;
    box-shadow: 0px 2px 5px rgba(0, 0, 0, 0.1); /* Optional shadow */
}

/* Background Gradient */
.login-background {
    flex: 1; /* Allows this section to take all available space */
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(to bottom, #ffffff, #f1f4f8); /* Subtle gradient */
    padding: 20px;
}

/* Login Box */
.login-container {
    max-width: 400px;
    background: rgba(255, 255, 255, 0.9); /* Semi-transparent white */
    padding: 2rem;
    border-radius: 10px;
    box-shadow: 0 6px 12px rgba(0, 0, 0, 0.15); /* Professional shadow */
    text-align: center;
}

/* Login Header */
.login-container h2 {
    margin-bottom: 20px;
    font-weight: bold;
    font-size: 1.8rem;
    color: #007c80; /* Teal color */
}

/* Input Fields */
.login-form label {
    font-weight: bold;
    color: #004d4f; /* Darker teal */
    margin-bottom: 8px;
    display: block;
    font-size: 0.9rem;
}

.login-form input {
    width: 100%;
    padding: 12px;
    margin-bottom: 20px;
    border: 1px solid #007c80; /* Teal border */
    border-radius: 8px;
    box-sizing: border-box;
    font-size: 1rem;
}

/* Input Focus State */
.login-form input:focus {
    border-color: #005f62; /* Darker teal focus */
    outline: none;
    box-shadow: 0 0 5px rgba(0, 124, 128, 0.5); /* Teal glow */
}

/* Login Button */
.btn-login {
    width: 100%;
    padding: 12px;
    background-color: #007c80; /* Teal button */
    color: white;
    border: none;
    border-radius: 8px;
    font-weight: bold;
    font-size: 1rem;
    cursor: pointer;
    transition: all 0.3s ease; /* Smooth transition */
}

.btn-login:hover {
    background-color: #005f62; /* Darker teal hover */
    transform: scale(1.02); /* Slight scaling */
}

/* Links */
.links a {
    display: block;
    margin-top: 15px;
    color: #007c80; /* Teal links */
    font-weight: 500;
    font-size: 0.9rem;
    text-decoration: none;
    transition: color 0.3s ease; /* Smooth transition */
}

.links a:hover {
    color: #005f62; /* Darker teal hover */
    text-decoration: underline;
}

/* Footer Styling */
footer {
    background-color: #f8f9fa; /* Light gray background */
    padding: 10px;
    text-align: center;
    font-size: 0.9rem;
    color: #555; /* Subtle gray text */
    border-top: 1px solid #e0e0e0; /* Subtle border for separation */
    position: fixed; /* Fix footer at the bottom */
    width: 100%; /* Full width */
    bottom: 0; /* Ensure it stays at the bottom */
}

/* Mobile Responsiveness */
@media (max-width: 768px) {
    .login-container {
        padding: 1.5rem;
        margin: 20px;
    }

    .login-form input {
        font-size: 0.9rem;
    }

    .btn-login {
        font-size: 0.9rem;
    }
}
    </style>
</head>
<body id="section_1">

    <header class="site-header">
        <div class="container">
            <div class="row align-items-center">
                
    
                
            </div>
        </div>
    </header>

    <nav class="navbar navbar-expand-lg bg-light shadow-lg">
        <div class="container">
            <a class="navbar-brand" href="/">
                <img src="turtlelogo1.png" class="logo img-fluid" alt="Turtle Shelter">
                <span>
                    Turtle Shelter Project
                    <small>Non-profit Organization</small>
                </span>
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            
        </div>
    </nav>
<body>
    <!-- Background Section -->
    <div class="login-background">
        <div class="login-container">
            <h2>Admin LogIn</h2> 
            
            <br><br>
            <form action="/login" method="POST" class="login-form">
                <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
                    <div class="error-box">
                        <p><%= errorMessage %></p>
                    </div>
                <% } %>
                
                <label for="username">Username:</label>
                <input type="text" id="username" name="username" placeholder="Enter your username" required>
                

                <label for="password">Password</label>
                <input type="password" id="password" name="password" placeholder="Enter your password" required>

                <button type="submit" class="btn-login">Log In</button>
            </form>

            <div class="links">
                <a href="/" class="link">Back to Home</a>
            </div>
        </div>
    </div>
    <!--footer partial-->
    <%- include('partials/adminFooter') %>
     <!-- JAVASCRIPT FILES -->
     <script src="js/jquery.min.js"></script>
     <script src="js/bootstrap.min.js"></script>
     <script src="js/jquery.sticky.js"></script>
     <script src="js/click-scroll.js"></script>
     <script src="js/counter.js"></script>
     <script src="js/custom.js"></script>
</body>
</html>

