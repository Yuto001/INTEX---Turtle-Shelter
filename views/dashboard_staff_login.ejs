<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Staff Management</title>
    <style>
        table {
            width: 100%;
            border-collapse: collapse;
        }
        th, td {
            border: 1px solid #ddd;
            padding: 8px;
            text-align: left;
        }
        th {
            background-color: #f4f4f4;
        }
        tr:nth-child(even) {
            background-color: #f9f9f9;
        }
        tr:hover {
            background-color: #f1f1f1;
        }
        button {
            padding: 5px 10px;
            margin: 2px;
            background-color: #007bff;
            color: white;
            border: none;
            cursor: pointer;
            border-radius: 3px;
        }
        button.delete {
            background-color: #dc3545;
        }
        button:hover {
            opacity: 0.9;
        }
    </style>
</head>
<body>
    <h1>Staff Accounts</h1>

    <!-- Link to Add New Staff -->
    <a href="/addStaff">
        <button>Add New Staff</button>
    </a>

    <h3>Existing Staff Accounts</h3>
    <table>
        <thead>
            <tr>
                <th>Username</th>
                <th>Password</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            <% staff.forEach(staffMember => { %>
                <tr>
                    <td><%= staffMember.username %></td>
                    <td><%= staffMember.password %></td>
                    <td>
                        <!-- Edit Button -->
                        <form action="/editStaff/<%= staffMember.username %>" method="POST" style="display: inline;">
                            <input type="password" name="password" placeholder="New password" required>
                            <button type="submit">Edit</button>
                        </form>

                        <!-- Delete Button -->
                        <form action="/deleteStaff/<%= staffMember.username %>" method="POST" style="display: inline;" onsubmit="return confirmDelete();">
                            <button type="submit" class="delete">Delete</button>
                        </form>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>

    <script>
        function confirmDelete() {
            return confirm("Are you sure you want to delete this staff member?");
        }
    </script>
</body>
</html>
