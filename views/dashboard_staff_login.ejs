<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Staff Management</title>
    <!-- CSS FILES -->
    <link href="/css/bootstrap.min.css" rel="stylesheet">
    <link href="/css/templatemo-kind-heart-charity.css" rel="stylesheet">
</head>
<body id="section_1">
    <%- include('partials/adminHeader') %>

    <div class="container mt-5">
        <h1 class="text-center mb-4">Staff Accounts</h1>

        <!-- Add New Staff Button -->
        <div class="d-flex justify-content-end mb-4">
            <a href="/addStaff" class="btn btn-primary">Add New Staff</a>
        </div>

        <!-- Existing Staff Accounts Table -->
        <div class="table-responsive">
            <table class="table table-bordered table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Username</th>
                        <th>Password</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% staff.forEach(staffMember => { %>
                        <tr>
                            <td><%= staffMember.username %></td>
                            <td><%= staffMember.password %></td>
                            <td>
                                <!-- Edit Button -->
                                <form action="/editStaff/<%= staffMember.username %>" method="POST" class="d-inline">
                                    <div class="input-group">
                                        <input type="password" name="password" class="form-control" placeholder="New password" required>
                                        <button type="submit" class="btn btn-warning btn-sm">Edit</button>
                                    </div>
                                </form>
                                <!-- Delete Button -->
                                <form action="/deleteStaff/<%= staffMember.username %>" method="POST" class="d-inline" onsubmit="return confirmDelete();">
                                    <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                </form>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Confirmation Script -->
    <script>
        function confirmDelete() {
            return confirm("Are you sure you want to delete this staff member?");
        }
    </script>
    <!-- JS FILES -->
    <script src="/js/bootstrap.min.js"></script>
    <script src="/js/jquery.min.js"></script>
    <script src="/js/custom.js"></script>
</body>
</html>
