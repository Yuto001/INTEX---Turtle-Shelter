<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Organizer Details</title>
    <!-- CSS FILES -->
    <link href="/css/bootstrap.min.css" rel="stylesheet">
    <link href="/css/bootstrap-icons.css" rel="stylesheet">
    <link href="/css/templatemo-kind-heart-charity.css" rel="stylesheet">
    <style>
        .container {
            margin-top: 50px;
        }
        h1, h2 {
            text-align: center;
            margin-bottom: 20px;
            font-size: 2rem;
            color: #333;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            background-color: #fff;
            box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);
        }
        th, td {
            border: 1px solid #ddd;
            padding: 10px;
            text-align: left;
        }
        th {
            background-color: #f4f4f4;
            font-weight: bold;
        }
        tr:nth-child(even) {
            background-color: #f9f9f9;
        }
        tr:hover {
            background-color: #f1f1f1;
        }
        .no-events {
            text-align: center;
            font-size: 1.2rem;
            color: #666;
        }
    </style>
</head>
<body id="section_1">
    <%- include('partials/adminHeader') %>

    <div class="container">
        <h1>Organizer Details</h1>
        <div class="mb-4">
            <p><strong>Name:</strong> <%= organizer.organizer_First %> <%= organizer.organizer_Last %></p>
            <p><strong>Email:</strong> <%= organizer.organizer_Email %></p>
            <p><strong>Phone:</strong> <%= organizer.organizer_Phone %></p>
        </div>

        <h2>Associated Events</h2>
        <% if (events.length > 0) { %>
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Event ID</th>
                        <th>City</th>
                        <th>Address</th>
                        <th>Date</th>
                        <th>Start Time</th>
                        <th>Description</th>
                        <th>Duration</th>
                    </tr>
                </thead>
                <tbody>
                    <% events.forEach(event => { %>
                        <tr>
                            <td><%= event.event_ID %></td>
                            <td><%= event.city %></td>
                            <td><%= event.address %></td>
                            <td>
                                <% if (event.event_Date) { %>
                                    <%= new Date(event.event_Date).toISOString().split('T')[0] %>
                                <% } else { %>
                                    N/A
                                <% } %>
                            </td>
                            <td><%= event.event_Start_Time %></td>
                            <td><%= event.event_Description %></td>
                            <td><%= event.event_Duration %> hours</td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        <% } else { %>
            <p class="no-events">No events associated with this organizer.</p>
        <% } %>
    </div>
    <%- include('partials/adminFooter') %>
    <!-- JAVASCRIPT FILES -->
    <script src="/js/jquery.min.js"></script>
    <script src="/js/bootstrap.min.js"></script>
    <script src="/js/jquery.sticky.js"></script>
    <script src="/js/custom.js"></script>
</body>
</html>

