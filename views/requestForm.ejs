<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Request Form</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 20px;
            line-height: 1.6;
        }
        form {
            max-width: 600px;
            margin: auto;
        }
        label {
            font-weight: bold;
            margin-top: 10px;
            display: block;
        }
        input, textarea, select {
            width: 100%;
            padding: 10px;
            margin: 5px 0 20px;
            border: 1px solid #ddd;
            border-radius: 5px;
            box-sizing: border-box;
        }
        button {
            padding: 10px 20px;
            background-color: #007bff;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }
        button:hover {
            background-color: #0056b3;
        }
    </style>
</head>
<%- include('partials/header') %>
<body>
    <h1>Request Form</h1>
    <form action="/submitRequest" method="POST">
        <!-- Email -->
        <label for="email">Email</label>
        <input type="email" id="email" name="email" required>

        <!-- Number of People Needed -->
        <label for="people_needed">Number of People Needed</label>
        <input type="number" id="people_needed" name="people_needed" min="1" required>

        <!-- Sewing at Event -->
        <label for="sewing">Sewing or non-sewing activities at Event?</label>
        <select id="sewing" name="sewing" required>
            <option value="Y">Yes</option>
            <option value="N">No</option>
            <option value="B">Both</option>
        </select>

        <!-- Date -->
        <label for="date">Date</label>
        <input type="date" id="date" name="date" required>

        <!-- City -->
        <label for="city">City</label>
        <input type="text" id="city" name="city" required>

        <!-- Street Address -->
        <label for="street_address">Street Address</label>
        <input type="text" id="street_address" name="street_address" required>

        <!-- Start Time -->
        <label for="start_time">Start Time</label>
        <input type="time" id="start_time" name="start_time" required>

        <!-- Length of Time -->
        <label for="length_of_time">Length of Time (in hours)</label>
        <input type="number" id="length_of_time" name="length_of_time" min="1" required>

        <!-- Organizer First Name -->
        <label for="organizer_first_name">First Name of Organizer</label>
        <input type="text" id="organizer_first_name" name="organizer_first_name" required>

        <!-- Organizer Last Name -->
        <label for="organizer_last_name">Last Name of Organizer</label>
        <input type="text" id="organizer_last_name" name="organizer_last_name" required>

        <!-- Organizer Phone Number -->
        <label for="organizer_phone">Organizer Phone Number</label>
        <input type="tel" id="organizer_phone" name="organizer_phone" pattern="[0-9]{10}" placeholder="1234567890" required>

        <!-- Story Sharing -->
        <label for="story">Would You Like a Story Shared?</label>
        <select id="story" name="story" required>
            <option value="Y">Yes</option>
            <option value="N">No</option>
        </select>

        <!-- Submit Button -->
        <button type="submit">Submit Request</button>
    </form>
</body>
</html>
