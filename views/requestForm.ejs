<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Request Form</title>
    <!-- CSS FILES -->
    <link href="/css/bootstrap.min.css" rel="stylesheet">
    <link href="/css/bootstrap-icons.css" rel="stylesheet">
    <link href="/css/templatemo-kind-heart-charity.css" rel="stylesheet">
    <style>
        .request-form .container {
            margin-top: 50px;
            max-width: 600px;
            background-color: #f9f9f9;
            padding: 30px;
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }
        .request-form h1 {
            text-align: center;
            margin-bottom: 30px;
            font-size: 2rem;
            color: #333;
        }
        .request-form label {
            font-weight: bold;
            margin-bottom: 5px;
            display: block;
        }
        .request-form input,
        .request-form textarea,
        .request-form select,
        .request-form button {
            width: 100%;
            padding: 10px;
            margin-bottom: 20px;
            border: 1px solid #ddd;
            border-radius: 5px;
            box-sizing: border-box;
        }
        .request-form button {
            background-color: #007bff;
            color: white;
            font-weight: bold;
            border: none;
            cursor: pointer;
        }
        .request-form button:hover {
            background-color: #0056b3;
        }
    </style>
</head>
<body id="section_1">
    <%- include('partials/header') %>

    <div class="request-form">
        <div class="container">
            <h1>Request Form</h1>
            <form action="/submitRequest" method="POST">
                <!-- Email -->
                <label for="email">Email</label>
                <input type="email" id="email" name="email" required>

                <!-- Number of People Needed -->
                <label for="people_needed">Number of People Needed</label>
                <input type="number" id="people_needed" name="people_needed" min="1" required>

                <!-- Sewing at Event -->
                <label for="sewing">Sewing or Non-Sewing Activities at Event?</label>
                <select id="sewing" name="sewing" required>
                    <option value="Y">Yes</option>
                    <option value="N">No</option>
                    <option value="B">Both</option>
                </select>

                <!-- Date -->
                <label for="date">Date</label>
                <input type="date" id="date" name="date" required>

                <!-- City -->
                <label for="city">City</label>
                <input type="text" id="city" name="city" required>

                <!-- Street Address -->
                <label for="street_address">Street Address</label>
                <input type="text" id="street_address" name="street_address" required>

                <!-- Start Time -->
                <label for="start_time">Start Time</label>
                <input type="time" id="start_time" name="start_time" required>

                <!-- Length of Time -->
                <label for="length_of_time">Length of Time (in hours)</label>
                <input type="number" id="length_of_time" name="length_of_time" min="1" required>

                <!-- Organizer First Name -->
                <label for="organizer_first_name">First Name of Organizer</label>
                <input type="text" id="organizer_first_name" name="organizer_first_name" required>

                <!-- Organizer Last Name -->
                <label for="organizer_last_name">Last Name of Organizer</label>
                <input type="text" id="organizer_last_name" name="organizer_last_name" required>

                <!-- Organizer Phone Number -->
                <label for="organizer_phone">Organizer Phone Number</label>
                <input type="tel" id="organizer_phone" name="organizer_phone" pattern="[0-9]{10}" placeholder="1234567890" required>

                <!-- Story Sharing -->
                <label for="story">Would You Like a Story Shared?</label>
                <select id="story" name="story" required>
                    <option value="Y">Yes</option>
                    <option value="N">No</option>
                </select>

                <!-- Submit Button -->
                <button type="submit">Submit Request</button>
            </form>
        </div>
    </div>

    <%- include('partials/footer') %>
    <!-- JAVASCRIPT FILES -->
    <script src="/js/jquery.min.js"></script>
    <script src="/js/bootstrap.min.js"></script>
    <script src="/js/jquery.sticky.js"></script>
    <script src="/js/custom.js"></script>
</body>
</html>
