<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Event Requests</title>
    <!-- CSS FILES -->
    <link href="/css/bootstrap.min.css" rel="stylesheet">
    <link href="/css/templatemo-kind-heart-charity.css" rel="stylesheet">
</head>
<body id="section_1">
    <%- include('partials/adminHeader') %>

    <div class="container mt-5">
        <h1 class="text-center mb-4">Event Requests</h1>

        <!-- Table -->
        <div class="table-responsive">
            <table class="table table-bordered table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Request ID</th>
                        <th>Organizer Email</th>
                        <th>Number of People</th>
                        <th>Sewing</th>
                        <th>Date</th>
                        <th>City</th>
                        <th>Street Address</th>
                        <th>Start Time</th>
                        <th>Length (hours)</th>
                        <th>Share Story</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% requests.forEach(request => { %>
                        <tr>
                            <td><%= request.request_Id %></td>
                            <td><%= request.organizer_Email %></td>
                            <td><%= request.num_People %></td>
                            <td><%= request.sewing %></td>
                            <td><%= request.request_Date %></td>
                            <td><%= request.request_City %></td>
                            <td><%= request.request_Street_Address %></td>
                            <td><%= request.request_Start_Time %></td>
                            <td><%= request.request_Length %></td>
                            <td><%= request.share_Story %></td>
                            <td>
                                <!-- Delete Button -->
                                <form action="/deleteEventRequest/<%= request.request_Id %>" method="POST" style="display: inline;" onsubmit="return confirmDelete();">
                                    <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>

        <!-- Back to Admin Dashboard -->
        <div class="d-flex justify-content-end mt-4">
            <a href="/adminDashboard" class="btn btn-secondary">Back to Admin Dashboard</a>
        </div>
    </div>

    <!-- Confirmation script for delete -->
    <script>
        function confirmDelete() {
            return confirm("Are you sure you want to delete this event request? This action cannot be undone.");
        }
    </script>
    <!-- JS FILES -->
    <script src="/js/bootstrap.min.js"></script>
    <script src="/js/jquery.min.js"></script>
    <script src="/js/custom.js"></script>
</body>
</html>
