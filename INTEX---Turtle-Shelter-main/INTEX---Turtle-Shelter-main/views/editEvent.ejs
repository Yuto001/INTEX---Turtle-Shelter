<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <form action="/editEvent" method="POST">
        <label for="city">City:</label>
        <input type="text" id="city" name="city" required>
        
        <label for="address">Address:</label>
        <input type="text" id="address" name="address" required>
        
        <label for="event_Date">Date:</label>
        <input type="date" id="event_Date" name="event_Date" required>
        
        <label for="event_Start_Time">Start Time:</label>
        <input type="time" id="event_Start_Time" name="event_Start_Time" required>

        <label for="organizer_Id">Organizer ID:</label>
        <input type="number" id="organizer_Id" name="organizer_Id" required>

        <label for="event_Duration">Event Duration:</label>
        <input type="number" id="event_Duration" name="event_Duration" required>

        <label for="event_Description">Description:</label>
        <input type="text" id="event_Description" name="event_Description" required>

        <label for="pockets">Number of Pockets Made:</label>
        <input type="number" id="pockets" name="pockets" required>

        <label for="collars">Number of Collars Made:</label>
        <input type="number" id="collars" name="collars" required>

        <label for="envelopes">Number of Envelopes Made:</label>
        <input type="number" id="envelopes" name="envelopes" required>

        <label for="vests">Number of Vests Made:</label>
        <input type="number" id="vests" name="vets" required>
        
        <label for="completed_Products">Completed_Products:</label>
        <input type="number" id="completed_Products" name="completed_Products" required>
        
        <button type="submit">Add Event</button>
      </form>
      
</body>
</html>